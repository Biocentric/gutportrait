/*
========================================================================================
    Nextflow config file for running nf-test tests
========================================================================================
*/

// The pipeline test runs `-profile test`, whose data is the in-repo synthetic fixture
// (conf/test.config). Nothing is fetched from nf-core/test-datasets; the base paths below
// are kept only because the nf-core module tests expect them.
params {
    modules_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'
    pipelines_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/gutportrait/'
}

// Fixes S3 access issues on self-hosted runners
aws.client.anonymous = true
