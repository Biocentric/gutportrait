/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: 'COLLAPSE_GENUS' {
        publishDir = [
            path: { "${params.outdir}/genus" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'TAXON_PERCENTILES' {
        ext.args   = { "--min-prevalence ${params.min_prevalence} --pseudocount ${params.pseudocount}" }
        publishDir = [
            path: { "${params.outdir}/percentiles" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'TAXON_PERCENTILES_CORRECTED' {
        ext.args   = { "--min-prevalence ${params.min_prevalence} --pseudocount ${params.pseudocount}" }
        ext.prefix = { "${meta.id}.corrected" }
        publishDir = [
            path: { "${params.outdir}/percentiles" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'BATCH_CORRECT' {
        ext.args   = { params.correction_covariates ? "--covariates ${params.correction_covariates}" : '' }
        publishDir = [
            path: { "${params.outdir}/batch" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'POSITIVE_CONTROL' {
        ext.args   = { [
            "--fold ${params.pc_fold}",
            "--alpha ${params.pc_alpha}",
            "--retain ${params.pc_retain}",
            "--min-prevalence ${params.pc_min_prevalence}",
            "--clr-prevalence ${params.min_prevalence}",
            "--pseudocount ${params.pseudocount}",
            "--seed ${params.seed}",
        ].join(' ') }
        publishDir = [
            path: { "${params.outdir}/gates" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'BATCH_DOMINANCE' {
        ext.args   = { [
            "--alpha ${params.dominance_alpha}",
            "--min-prevalence ${params.min_prevalence}",
            "--pseudocount ${params.pseudocount}",
            "--min-study-n ${params.min_study_n}",
        ].join(' ') }
        publishDir = [
            path: { "${params.outdir}/gates" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'PERCENTILE_STABILITY' {
        ext.args   = { "--low-pct ${params.stability_low_percentile} --high-pct ${params.stability_high_percentile}" }
        publishDir = [
            path: { "${params.outdir}/percentiles" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'BATCH_DIAGNOSE' {
        ext.args   = { [
            "--min-prevalence ${params.min_prevalence}",
            "--pseudocount ${params.pseudocount}",
            "--permutations ${params.permutations}",
            "--seed ${params.seed}",
            "--banner-r2 ${params.banner_r2_study}",
            "--min-n ${params.min_study_n}",
        ].join(' ') }
        publishDir = [
            path: { "${params.outdir}/batch" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'ALPHA_DIVERSITY' {
        ext.args   = { [
            "--depth ${params.rarefaction_depth}",
            "--iterations ${params.rarefaction_iterations}",
            "--seed ${params.seed}",
            "--min-study-n ${params.min_study_n}",
            "--low-pct ${params.flag_low_percentile}",
            "--high-pct ${params.flag_high_percentile}",
        ].join(' ') }
        publishDir = [
            path: { "${params.outdir}/alpha" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'DEVIATION_FLAGS' {
        ext.args   = { [
            "--low-pct ${params.flag_low_percentile}",
            "--high-pct ${params.flag_high_percentile}",
            "--dominance ${params.dominance_threshold}",
            "--core-prevalence ${params.core_prevalence}",
            "--core-min-expected ${params.core_min_expected}",
            "--min-prevalence ${params.min_prevalence}",
            "--pseudocount ${params.pseudocount}",
            "--min-study-n ${params.min_study_n}",
        ].join(' ') }
        publishDir = [
            path: { "${params.outdir}/flags" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'WITHIN_PERSON' {
        ext.args   = { [
            "--min-prevalence ${params.min_prevalence}",
            "--pseudocount ${params.pseudocount}",
            "--change-z ${params.change_z}",
            "--min-pairs ${params.min_reference_pairs}",
            "--identity-within-pct ${params.identity_within_percentile}",
            "--identity-between-pct ${params.identity_between_percentile}",
        ].join(' ') }
        publishDir = [
            path: { "${params.outdir}/within_person" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'TECHNICAL_QC' {
        ext.args   = { "--max-z ${params.qc_max_z} --min-study-n ${params.min_study_n}" }
        publishDir = [
            path: { "${params.outdir}/qc" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'REPORT' {
        ext.args   = { [
            "--taxonomy-db ${params.taxonomy_db}",
            "--flag-low-pct ${params.flag_low_percentile}",
            "--flag-high-pct ${params.flag_high_percentile}",
            "--dominance ${params.dominance_threshold}",
            "--core-prevalence ${params.core_prevalence}",
            "--stability-low-pct ${params.stability_low_percentile}",
            "--stability-high-pct ${params.stability_high_percentile}",
            "--change-z ${params.change_z}",
            "--qc-max-z ${params.qc_max_z}",
        ].join(' ') }
        publishDir = [
            path: { "${params.outdir}/report" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode
        ]
    }

}
