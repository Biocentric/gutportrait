/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run Biocentric/gutportrait -profile test,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    // Synthetic fixture with planted signals; see tests/fixtures/make_synthetic_fixture.py.
    // Real panel data cannot ship in a public repo, and ampliseq's own test data is too
    // small for percentiles, PERMANOVA or cohort matching.
    input            = "${projectDir}/tests/fixtures/synthetic/samplesheet.csv"
    ampliseq_results = "${projectDir}/tests/fixtures/synthetic/ampliseq_results"
}
