/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running full-size tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a full size pipeline test.

    Use as follows:
        nextflow run Biocentric/gutportrait -profile test_full,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'Full test profile'
    config_profile_description = 'Synthetic fixture without the CI resource caps'

    // There is no public full-size dataset for this pipeline, and there cannot be one: a
    // real run co-processes one person's reads with a public panel, and the personal half
    // is not redistributable. Full-size validation runs privately on real ampliseq output.
    // Until a larger synthetic fixture exists, this profile runs the same synthetic data
    // as `test`, without the resource limits that profile sets for CI runners.
    input            = "${projectDir}/tests/fixtures/synthetic/samplesheet.csv"
    ampliseq_results = "${projectDir}/tests/fixtures/synthetic/ampliseq_results"
}
