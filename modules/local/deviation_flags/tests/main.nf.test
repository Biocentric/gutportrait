nextflow_process {

    name "Test Process DEVIATION_FLAGS"
    script "../main.nf"
    process "DEVIATION_FLAGS"

    tag "modules"
    tag "modules_local"
    tag "deviation_flags"

    test("synthetic fixture: only self_P3 raises flags, each with its reference fire rate") {

        setup {
            run("ALPHA_DIVERSITY") {
                script "../../alpha_diversity/main.nf"
                process {
                    """
                    input[0] = channel.of([ [ id: 'native' ], file("${projectDir}/tests/fixtures/synthetic/ampliseq_results/dada2/ASV_table.tsv", checkIfExists: true) ])
                    input[1] = file("${projectDir}/tests/fixtures/synthetic/samplesheet.csv", checkIfExists: true)
                    """
                }
            }
        }

        when {
            process {
                """
                input[0] = channel.of([ [ id: 'native' ], file("${projectDir}/tests/fixtures/synthetic/ampliseq_results/dada2/ASV_table.tsv", checkIfExists: true), file("${projectDir}/tests/fixtures/synthetic/ampliseq_results/dada2/ASV_tax_species.silva.tsv", checkIfExists: true) ]).join(ALPHA_DIVERSITY.out.alpha)
                input[1] = file("${projectDir}/tests/fixtures/synthetic/samplesheet.csv", checkIfExists: true)
                """
            }
        }

        then {
            assert process.success
            def flags = path(process.out.flags.get(0).get(1)).readLines()
            assert flags.first().split('\t').contains('reference_fire_rate')
            assert flags.findAll { line -> line.split('\t')[3] == 'yes' }.every { line -> line.startsWith('self_P3\t') }
            assert flags.any { line -> line.startsWith('self_P3\t') && line.contains('\texcess_extremes\tyes\t') }
            assert path(process.out.calibration.get(0).get(1)).readLines().size() == 9
            assert snapshot(
                process.out.flags,
                process.out.calibration,
                process.out.findAll { key, val -> key.toString().startsWith('versions') }
            ).match()
        }
    }
}
