nextflow_process {

    name "Test Process BATCH_DOMINANCE"
    script "../main.nf"
    process "BATCH_DOMINANCE"

    tag "modules"
    tag "modules_local"
    tag "batch_dominance"

    test("synthetic fixture: banner up, age a finding, sex and BMI orientation only") {

        setup {
            run("COLLAPSE_GENUS") {
                script "../../collapse_genus/main.nf"
                process {
                    """
                    input[0] = channel.of([ [ id: 'native' ], file("${projectDir}/tests/fixtures/synthetic/ampliseq_results/dada2/ASV_table.tsv", checkIfExists: true), file("${projectDir}/tests/fixtures/synthetic/ampliseq_results/dada2/ASV_tax_species.silva.tsv", checkIfExists: true) ])
                    """
                }
            }
            run("BATCH_DIAGNOSE") {
                script "../../batch_diagnose/main.nf"
                process {
                    """
                    input[0] = COLLAPSE_GENUS.out.counts
                    input[1] = file("${projectDir}/tests/fixtures/synthetic/samplesheet.csv", checkIfExists: true)
                    """
                }
            }
        }

        when {
            process {
                """
                input[0] = BATCH_DIAGNOSE.out.permanova.join(BATCH_DIAGNOSE.out.summary).join(COLLAPSE_GENUS.out.counts)
                input[1] = file("${projectDir}/tests/fixtures/synthetic/samplesheet.csv", checkIfExists: true)
                """
            }
        }

        then {
            assert process.success
            assert snapshot(
                process.out.gates,
                process.out.findAll { key, val -> key.toString().startsWith('versions') }
            ).match()
        }
    }

    test("a contrast collinear with study is orientation only") {

        setup {
            run("COLLAPSE_GENUS") {
                script "../../collapse_genus/main.nf"
                process {
                    """
                    input[0] = channel.of([ [ id: 'native' ], file("${projectDir}/tests/fixtures/synthetic/ampliseq_results/dada2/ASV_table.tsv", checkIfExists: true), file("${projectDir}/tests/fixtures/synthetic/ampliseq_results/dada2/ASV_tax_species.silva.tsv", checkIfExists: true) ])
                    """
                }
            }
            run("BATCH_DIAGNOSE") {
                script "../../batch_diagnose/main.nf"
                process {
                    """
                    input[0] = COLLAPSE_GENUS.out.counts
                    input[1] = file("${projectDir}/tests/fixtures/synthetic/samplesheet_collinear.csv", checkIfExists: true)
                    """
                }
            }
        }

        when {
            process {
                """
                input[0] = BATCH_DIAGNOSE.out.permanova.join(BATCH_DIAGNOSE.out.summary).join(COLLAPSE_GENUS.out.counts)
                input[1] = file("${projectDir}/tests/fixtures/synthetic/samplesheet_collinear.csv", checkIfExists: true)
                """
            }
        }

        then {
            assert process.success
            assert snapshot(
                process.out.gates,
                process.out.findAll { key, val -> key.toString().startsWith('versions') }
            ).match()
        }
    }
}
