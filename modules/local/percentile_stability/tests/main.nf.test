nextflow_process {

    name "Test Process PERCENTILE_STABILITY"
    script "../main.nf"
    process "PERCENTILE_STABILITY"

    tag "modules"
    tag "modules_local"
    tag "percentile_stability"

    test("synthetic fixture: positions against the uncorrected and the corrected panel") {

        config "./nextflow.config"

        setup {
            run("COLLAPSE_GENUS") {
                script "../../collapse_genus/main.nf"
                process {
                    """
                    input[0] = channel.of([ [ id: 'native' ], file("${projectDir}/tests/fixtures/synthetic/ampliseq_results/dada2/ASV_table.tsv", checkIfExists: true), file("${projectDir}/tests/fixtures/synthetic/ampliseq_results/dada2/ASV_tax_species.silva.tsv", checkIfExists: true) ])
                    """
                }
            }
            run("BATCH_CORRECT") {
                script "../../batch_correct/main.nf"
                process {
                    """
                    input[0] = COLLAPSE_GENUS.out.counts
                    input[1] = file("${projectDir}/tests/fixtures/synthetic/samplesheet.csv", checkIfExists: true)
                    """
                }
            }
            run("TAXON_PERCENTILES", alias: "TP_UNCORRECTED") {
                script "../../taxon_percentiles/main.nf"
                process {
                    """
                    input[0] = COLLAPSE_GENUS.out.counts
                    input[1] = file("${projectDir}/tests/fixtures/synthetic/samplesheet.csv", checkIfExists: true)
                    """
                }
            }
            run("TAXON_PERCENTILES", alias: "TP_CORRECTED") {
                script "../../taxon_percentiles/main.nf"
                process {
                    """
                    input[0] = BATCH_CORRECT.out.counts
                    input[1] = file("${projectDir}/tests/fixtures/synthetic/samplesheet.csv", checkIfExists: true)
                    """
                }
            }
        }

        when {
            process {
                """
                input[0] = TP_UNCORRECTED.out.percentiles.join(TP_CORRECTED.out.percentiles)
                """
            }
        }

        then {
            assert process.success
            assert snapshot(
                process.out.stability,
                process.out.findAll { key, val -> key.toString().startsWith('versions') }
            ).match()
        }
    }
}
